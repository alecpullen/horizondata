# API URL for backend session service
# For local development: http://localhost:8080
# For Vercel + local backend via ngrok: https://your-ngrok-url.ngrok-free.app
VITE_API_URL=http://localhost:8080

# Public app URL used for QR codes and student join links on the session lobby screen.
# Defaults to the browser's origin at runtime if not set.
# For local development: http://localhost:5173
VITE_APP_URL=http://localhost:5173

