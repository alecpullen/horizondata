# Database Configuration Template for NEON PostgreSQL
# Copy this file to .env and fill in your actual credentials

# Database Connection
DB_HOST=ep-your-neon-host.example.com
DB_PORT=5432
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASSWORD=your_secure_password

# Connection String (optional - will be auto-generated from above)
SQLALCHEMY_DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@DB_HOST:DB_NAME?channel_binding=require&sslmode=require

# Connection Pool Settings (optimized for NEON)
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE=3600

# SSL Configuration (required for NEON)
SSL_MODE=require
CHANNEL_BINDING=require
# JWT Secret — generate a strong random string for production (e.g. openssl rand -hex 32)
JWT_SECRET_KEY=change-me-to-a-random-secret

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MediaMTX RTSP URL for headless frame grabs during live sessions.
# When streaming runs locally alongside API: rtsp://localhost:8554/telescope-camera
# When API runs in Docker and streaming runs locally: rtsp://host.docker.internal:8554/telescope-camera
# When streaming is on a separate server: rtsp://<streaming-host>:8554/telescope-camera
MEDIAMTX_RTSP_URL=rtsp://localhost:8554/telescope-camera