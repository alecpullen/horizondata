# Database Configuration Template
# Copy this file to .env and fill in your actual credentials

# --- Option A: Full connection string (recommended for Neon/cloud databases) ---
# DATABASE_URL=postgresql://user:password@host/dbname
DATABASE_URL=

# --- Option B: Individual components (for local Postgres) ---
# Leave DATABASE_URL empty above and fill these in instead
DB_HOST=localhost
DB_PORT=5432
DB_NAME=horizon
DB_USER=postgres
DB_PASSWORD=postgres

# SSL mode: "require" for Neon/cloud, "prefer" or "disable" for local dev
# Automatically defaults to "require" when DATABASE_URL is set, "prefer" otherwise
DATABASE_SSL_MODE=

# Connection pool settings
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE=3600

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# WARNING: if not set, an ephemeral random key is generated each restart (tokens lost on reload)
JWT_SECRET_KEY=change-me-to-a-strong-random-secret

# --- Flask ---
FLASK_DEBUG=false
FLASK_HOST=127.0.0.1
PORT=8080

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- MediaMTX RTSP ---
# For local dev alongside API: rtsp://localhost:8554/telescope-camera
# For Docker: rtsp://host.docker.internal:8554/telescope-camera
MEDIAMTX_RTSP_URL=rtsp://localhost:8554/telescope-camera
